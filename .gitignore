# Environnements virtuels
env/
venv/
ENV/

# Fichiers de configuration sensibles
.env
*.env
*.key
*.pem

# Fichiers Python compilés
__pycache__/
*.py[cod]
*$py.class

# Bases de données locales
*.sqlite3

# Logs
*.log

# Dossiers de cache
.cache/
*.cache

# Fichiers système (macOS / Windows)
.DS_Store
Thumbs.db

# Dossiers de dépendances Node.js (si frontend intégré)
node_modules/

# Dossiers de build ou de déploiement
build/
dist/

# Dossiers spécifiques à l’IDE
.vscode/
.idea/

# Fichiers de migration compilés
*/migrations/*.pyc
*/migrations/__pycache__/

# Fichiers créés par les exercices Python
python/04_fichiers/sortie/*
!python/04_fichiers/sortie/.gitkeep

# Fichiers uploadés (QR codes générés)
media/

# Livres et cours en PDF (droits d'auteur)
*.pdf
